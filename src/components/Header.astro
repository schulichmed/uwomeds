---
import { href } from '../lib/paths';

interface MenuItem { label: string; url: string }
interface MenuGroup { label: string; url?: string; items?: MenuItem[] }

// Matches the current site's primary menu (spec; plan Task 15). The menu is code, not content.
const menu: MenuGroup[] = [
  {
    label: 'Council',
    items: [
      { label: 'Members', url: '/council/' },
      { label: 'Documents', url: '/documents/' },
      { label: 'Meetings and Updates', url: '/meetings-and-updates/' },
      { label: 'Sponsors', url: '/sponsors/' },
    ],
  },
  {
    label: 'Resources',
    items: [
      { label: 'Academic & Research Opportunities', url: '/academic/' },
      { label: 'Extracurricular', url: '/extracurricular/' },
      { label: 'Educational', url: '/educational/' },
      { label: 'Wellness', url: '/wellness/' },
    ],
  },
  {
    label: 'Involvement',
    items: [
      { label: 'Club Directory', url: '/clubs/' },
      { label: 'Calendar', url: '/calendar/' },
      { label: 'Event & Room Booking', url: '/room-booking/' },
      { label: 'Club Event Report', url: '/club-event-report/' },
    ],
  },
  {
    label: 'Links',
    items: [
      { label: 'Elentra', url: '/links/#elentra' },
      { label: 'OWL', url: '/links/#owl' },
      { label: 'Western Email', url: '/links/#western-email' },
      { label: 'Schulich Hub', url: '/links/#schulich-hub' },
      { label: 'Western Libraries', url: '/links/#western-libraries' },
    ],
  },
  { label: 'MedFriend', url: '/medfriend/' },
  { label: 'Contact', url: '/contact/' },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={href('/')}>
      <svg class="brand-mark" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" focusable="false">
        <circle cx="20" cy="20" r="19" fill="#522d80" />
        <path d="M20 8v24M12 14c4 0 8 2 8 6s4 6 8 6M28 14c-4 0-8 2-8 6s-4 6-8 6" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" />
      </svg>
      <span><span class="brand-name">Hippocratic Council</span><span class="brand-sub">Schulich Medicine</span></span>
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="menu">
        {menu.map((group) =>
          group.items ? (
            <li class="has-sub">
              <details>
                <summary>{group.label}</summary>
                <ul class="submenu">
                  {group.items.map((item) => <li><a href={href(item.url)}>{item.label}</a></li>)}
                </ul>
              </details>
            </li>
          ) : (
            <li><a class="top-link" href={href(group.url ?? '/')}>{group.label}</a></li>
          ),
        )}
      </ul>
      <div id="auth-area" class="auth-area">
        <a class="button small" href={href('/login/')}>Sign in</a>
      </div>
    </nav>
  </div>
</header>
