---
import { QUICK_LINKS } from '../data/links';
import { href } from '../lib/paths';
import { SECTIONS, sectionFor } from './sections';

interface MenuItem { label: string; url: string }
interface MenuGroup { label: string; url?: string; items?: MenuItem[] }

/** Site paths go under the base; outbound links (the Links menu) stay as they are. */
const link = (url: string) => (/^https?:/.test(url) ? url : href(url));

// Matches the current site's primary menu (spec; plan Task 15). The menu is code, not content.
// MedFriend is its own top-level item: the one new menu entry (Noor, 2026-11-06).
const current = sectionFor(Astro.url.pathname);
const sectionOf = (label: string) => SECTIONS.find((s) => s.label === label)?.id;

const menu: MenuGroup[] = [
  {
    label: 'Council',
    items: [
      { label: 'Members', url: '/council/' },
      { label: 'Documents', url: '/documents/' },
      { label: 'Meetings and Updates', url: '/meetings-and-updates/' },
      { label: 'Sponsors', url: '/sponsors/' },
    ],
  },
  {
    label: 'Resources',
    items: [
      { label: 'Academic & Research Opportunities', url: '/academic/' },
      { label: 'Extracurricular', url: '/extracurricular/' },
      { label: 'Educational', url: '/educational/' },
      { label: 'Wellness', url: '/wellness/' },
      { label: 'Research From Home', url: '/research-from-home/' },
    ],
  },
  {
    label: 'Involvement',
    items: [
      { label: 'Club Directory', url: '/clubs/' },
      { label: 'Calendar', url: '/calendar/' },
      { label: 'Event & Room Booking', url: '/room-booking/' },
    ],
  },
  { label: 'MedFriend', url: '/medfriend/' },
  {
    label: 'Links',
    items: QUICK_LINKS.map((l) => ({ label: `${l.label} \u2197`, url: l.url })),
  },
  { label: 'Contact', url: '/contact/' },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={href('/')}>
      <img src={href('/hippo-logo.png')} alt="Hippocratic Council" width="142" height="43" />
    </a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="menu">
        {menu.map((group) =>
          group.items ? (
            <li class="has-sub" data-section={sectionOf(group.label)} data-current={sectionOf(group.label) && sectionOf(group.label) === current ? '' : undefined}>
              <details>
                <summary>{sectionOf(group.label) && <span class="swatch" aria-hidden="true"></span>}{group.label}</summary>
                <ul class="submenu">
                  {group.items.map((item) => <li><a href={link(item.url)}>{item.label}</a></li>)}
                </ul>
              </details>
            </li>
          ) : (
            <li data-section={sectionOf(group.label)} data-current={sectionOf(group.label) && sectionOf(group.label) === current ? '' : undefined}><a class="top-link" href={href(group.url ?? '/')} aria-current={sectionOf(group.label) && sectionOf(group.label) === current ? 'page' : undefined}>{sectionOf(group.label) && <span class="swatch" aria-hidden="true"></span>}{group.label}</a></li>
          ),
        )}
      </ul>
      <a class="search-link" href={href('/clubs/#club-search')} aria-label="Search the club directory" title="Search the club directory">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </a>
      <div id="auth-area" class="auth-area">
        <a class="button small" href={href('/login/')}>Login</a>
      </div>
    </nav>
  </div>
</header>
