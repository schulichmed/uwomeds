---
import Base from '../../../layouts/Base.astro';
import { CLUBS } from '../../../data/clubs';
import { clubPageHtml } from '../../../lib/render-club';
import { href } from '../../../lib/paths';
import type { Club } from '../../../lib/types';

export function getStaticPaths() {
  return CLUBS.map((club) => ({ params: { slug: club.slug }, props: { club } }));
}
const { club } = Astro.props as { club: Club };
---
<Base title={club.name}>
  <p class="muted"><a href={href('/clubs/')}>Club directory</a> / {club.name}</p>
  <h1>{club.name}</h1>
  <div id="club-body" data-slug={club.slug}>
    <Fragment set:html={clubPageHtml(club, false)} />
  </div>
</Base>

<script>
  import { esc } from '../../../lib/escape';
  import { href } from '../../../lib/paths';
  import { clubPageHtml } from '../../../lib/render-club';
  import { canEditClub, getClub, getSession, listEventReports } from '../../../lib/store';

  const body = document.getElementById('club-body') as HTMLElement;
  const slug = body.dataset.slug ?? '';
  const club = getClub(slug);
  const isOwnExec = canEditClub(getSession(), slug);
  if (club) body.innerHTML = clubPageHtml(club, isOwnExec);

  // The club's event reports are visible to its own execs only.
  if (club && isOwnExec) {
    const reports = listEventReports(slug);
    const items = reports
      .map(
        (r) =>
          `<li><strong>#${r.number} ${esc(r.eventTitle)}</strong><br>${esc(new Date(`${r.date}T12:00`).toLocaleDateString('en-CA', { dateStyle: 'medium' }))} · ${r.attendance} attended · sent by ${esc(r.submittedBy)}${r.notes ? `<br><span class="muted">${esc(r.notes)}</span>` : ''}</li>`,
      )
      .join('');
    body.insertAdjacentHTML(
      'beforeend',
      `<section id="event-reports" aria-labelledby="reports-h"><h2 id="reports-h">Event reports (execs only)</h2>${
        reports.length ? `<ul class="agenda">${items}</ul>` : '<p class="muted">No event reports yet.</p>'
      }<p><a class="button secondary small" href="${href('/club-event-report/')}">Send an event report</a></p></section>`,
    );
  }

  body.addEventListener('click', (ev) => {
    const button = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-ig-toggle]');
    if (!button) return;
    const panel = document.getElementById('ig-panel');
    if (!panel) return;
    const open = button.getAttribute('aria-expanded') === 'true';
    panel.hidden = open;
    button.setAttribute('aria-expanded', String(!open));
    button.textContent = open ? 'Show recent Instagram posts' : 'Hide recent Instagram posts';
  });
</script>
