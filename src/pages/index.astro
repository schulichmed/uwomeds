---
import Base from '../layouts/Base.astro';
import EventsCalendar from '../components/EventsCalendar.astro';
import { href } from '../lib/paths';
---
<Base title="Home">
  <section class="hero" slot="full-bleed" aria-labelledby="hero-h">
    <div class="wrap hero-inner">
      <h1 id="hero-h">Schulich Meds</h1>
      <img class="hero-art" src={href('/hero-people.png')} alt="" width="1024" height="819" />
    </div>
  </section>

  <section class="home-calendar" aria-label="Events calendar">
    <p class="demo-note">Demo: the real site shows the council's Google Calendar here. This month view uses sample events and the bookings approved in this browser.</p>
    <EventsCalendar />
  </section>

  <ul class="tiles">
    <li class="tile">
      <h2><a href={href('/clubs/')}>Club directory</a></h2>
      <p>Every club on both campuses. Club execs keep their own page up to date.</p>
    </li>
    <li class="tile">
      <h2><a href={href('/room-booking/')}>Event &amp; room booking</a></h2>
      <p>Sign in with your Western email and request a room. Approved bookings go on the events calendar automatically.</p>
    </li>
    <li class="tile">
      <h2><a href={href('/calendar/')}>Events calendar</a></h2>
      <p>Council and club events for London and Windsor.</p>
    </li>
    <li class="tile">
      <h2><a href={href('/council/')}>Your council</a></h2>
      <p>Who's on council and how it's organised.</p>
    </li>
    <li class="tile">
      <h2><a href={href('/medfriend/')}>MedFriend</a></h2>
      <p>Preclerkship notes, questions and Anki decks, for Western students.</p>
    </li>
    <li class="tile">
      <h2><a href={href('/wellness/')}>Wellness</a></h2>
      <p>Supports and wellness events.</p>
    </li>
  </ul>

  <section class="notice" aria-labelledby="try-h">
    <h2 id="try-h">Trying the demo</h2>
    <p>Use <strong>Demo persona</strong> in the yellow banner to switch between a student, a club exec, the booking admin, a page editor and the IT Director, or <a href={href('/login/')}>sign in</a> with any sample <code>@meds.uwo.ca</code> address. <strong>Reset demo</strong> puts everything back.</p>
  </section>
</Base>
