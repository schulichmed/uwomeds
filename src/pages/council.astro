---
import Base from '../layouts/Base.astro';
import { COUNCIL } from '../data/council';
---
<Base title="Council members">
  <h1>Council members</h1>
  <p class="lead">Meet the members of the Hippocratic Council.</p>

  <ul class="org-row">
    {COUNCIL.map((m) => <li class="person"><span class="role">{m.role}</span>{m.name}</li>)}
  </ul>
</Base>
