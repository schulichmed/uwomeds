---
// Step 2 of sign-in: type the 6-digit code from the email.
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import { normaliseEmail } from '../../../lib/email-domain';
import { createServerClient, safeNext, setWhoCookie } from '../../../lib/supabase';

let email = normaliseEmail(Astro.url.searchParams.get('email') ?? '');
let next = safeNext(Astro.url.searchParams.get('next'));
let error = '';
const supabase = createServerClient(Astro);

if (Astro.request.method === 'POST' && supabase) {
  const form = await Astro.request.formData();
  email = normaliseEmail(String(form.get('email') ?? ''));
  next = safeNext(String(form.get('next') ?? ''));
  const token = String(form.get('code') ?? '').replace(/\s+/g, '');
  const { data, error: verifyError } = await supabase.auth.verifyOtp({ email, token, type: 'email' });
  if (!verifyError && data.user?.email) {
    setWhoCookie(Astro, data.user.email);
    Astro.cookies.delete('uwomeds_next', { path: '/' });
    return Astro.redirect(next, 303);
  }
  error = "That code doesn't match or has expired. Check the latest email, or start again.";
}
---
<Base title="Enter your code">
  {
    email ? (
      <>
        <h1>Check your email</h1>
        <p class="lead">We sent a 6-digit code and a sign-in link to <strong>{email}</strong>. Use either one; both work for 1 hour.</p>
        <form method="post" class="stack" novalidate>
          <input type="hidden" name="email" value={email} />
          <input type="hidden" name="next" value={next} />
          <div class={`field${error ? ' has-error' : ''}`}>
            <label for="code">6-digit code</label>
            <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6"
              pattern="[0-9]{6}" aria-describedby={error ? 'code-error' : undefined} aria-invalid={error ? 'true' : undefined} required autofocus />
            {error && <p class="error" id="code-error" role="alert">{error}</p>}
          </div>
          <p class="button-row">
            <button class="button" type="submit">Sign in</button>
            <a href="/login/">Use a different email</a>
          </p>
        </form>
        <p class="muted">Nothing arrived? Check your junk folder, then <a href="/login/">ask for a new code</a>.</p>
      </>
    ) : (
      <>
        <h1>Start again</h1>
        <p><a href="/login/">Enter your email</a> to get a code.</p>
      </>
    )
  }
</Base>
