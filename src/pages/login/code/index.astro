---
import Base from '../../../layouts/Base.astro';
import { href } from '../../../lib/paths';
---
<Base title="Enter your code">
  <div id="no-pending" hidden>
    <h1>Start again</h1>
    <p>We don't have a sign-in in progress in this browser. <a href={href('/login/')}>Enter your email</a> to get a code.</p>
  </div>
  <div id="code-step" hidden>
    <h1>We emailed you a 6-digit code</h1>
    <p class="lead">Sent to <strong id="sent-to"></strong>. It's valid for 10 minutes. The email also has a sign-in link.</p>
    <div class="demo-note" aria-live="polite">
      <p><strong>Demo:</strong> no email is sent. Your code is</p>
      <p class="code-display" id="demo-code"></p>
    </div>
    <form id="code-form" class="stack" novalidate>
      <div class="field" id="code-field">
        <label for="code">6-digit code</label>
        <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" aria-describedby="code-error" required />
        <p class="error" id="code-error" hidden></p>
      </div>
      <p class="button-row">
        <button class="button" type="submit">Sign in</button>
        <a href={href('/login/')}>Use a different email</a>
      </p>
    </form>
  </div>
</Base>

<script>
  import { href } from '../../../lib/paths';
  import { clearPendingSignIn, getPendingSignIn, setFlash, signIn } from '../../../lib/store';

  const pending = getPendingSignIn();
  const next = new URLSearchParams(window.location.search).get('next') ?? '/';
  if (!pending) {
    (document.getElementById('no-pending') as HTMLElement).hidden = false;
  } else {
    (document.getElementById('code-step') as HTMLElement).hidden = false;
    (document.getElementById('sent-to') as HTMLElement).textContent = pending.email;
    (document.getElementById('demo-code') as HTMLElement).textContent = pending.code;
    const input = document.getElementById('code') as HTMLInputElement;
    const error = document.getElementById('code-error') as HTMLElement;
    input.focus();
    document.getElementById('code-form')?.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const code = input.value.replace(/\s+/g, '');
      if (code !== pending.code) {
        error.textContent = "That code doesn't match. Check the latest email and try again.";
        error.hidden = false;
        document.getElementById('code-field')?.classList.add('has-error');
        input.setAttribute('aria-invalid', 'true');
        input.focus();
        return;
      }
      const session = signIn(pending.email);
      clearPendingSignIn();
      setFlash(`Signed in as ${session.email}.`);
      const safeNext = next.startsWith('/') && !next.startsWith('//') ? next : '/';
      window.location.href = href(safeNext);
    });
  }
</script>
