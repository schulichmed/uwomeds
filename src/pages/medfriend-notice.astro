---
// Shown once, the first time a reader opens MedFriend (plan Task 26). Pressing
// "I understand" records it on their profile and takes them where they were going.
export const prerender = false;
import Base from '../layouts/Base.astro';
import { requireUser } from '../lib/auth';
import { createServerClient } from '../lib/supabase';

const denied = requireUser(Astro);
if (denied) return denied;

/** Only back into MedFriend. */
const medfriendNext = (raw: string | null) => {
  const n = (raw ?? '').trim();
  return /^\/medfriend(\/|$)/.test(n) && !n.startsWith('//') ? n : '/medfriend/';
};

let next = medfriendNext(Astro.url.searchParams.get('next'));
let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  next = medfriendNext(String(form.get('next') ?? ''));
  const supabase = createServerClient(Astro);
  const { error: saveError } = supabase
    ? await supabase.from('profiles').update({ medfriend_notice_at: new Date().toISOString() }).eq('id', Astro.locals.user!.id)
    : { error: new Error('not set up') };
  if (!saveError) return Astro.redirect(next, 303);
  error = "That didn't save. Try again in a minute.";
}
---
<Base title="Before you use MedFriend">
  <h1>Before you use MedFriend</h1>
  <ul>
    <li>MedFriend is made by students. It is not official Schulich curriculum or medical advice.</li>
    <li>It can be wrong or out of date, so check it against your course materials.</li>
    <li>Never put patient information in a report.</li>
  </ul>
  <p>The full wording is in the <a href="/terms/">terms of use</a>.</p>
  {error && <p class="error" role="alert">{error}</p>}
  <form method="post">
    <input type="hidden" name="next" value={next} />
    <button class="button" type="submit">I understand</button>
  </form>
</Base>
