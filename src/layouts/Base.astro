---
import DemoBanner from '../components/DemoBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props { title: string; description?: string }
const { title, description = 'Schulich Hippocratic Council: council, clubs, room booking and resources for Schulich medical students.' } = Astro.props;
const fullTitle = title === 'Home' ? 'Hippocratic Council (demo)' : `${title} | Hippocratic Council (demo)`;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <DemoBanner />
    <Header />
    <main id="main" class="wrap" tabindex="-1">
      <div id="flash" class="flash" role="status" hidden></div>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
