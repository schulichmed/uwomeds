---
import DemoBanner from '../components/DemoBanner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href } from '../lib/paths';
import { SECTIONS, sectionFor } from '../components/sections';
import { PHOTOS, photoFor } from '../components/photos';
// Archivo (variable weight and width), self-hosted so pages make no external requests.
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';

interface Props { title: string; description?: string }
const { title, description = 'Schulich Hippocratic Council: council, clubs, room booking and resources for Schulich medical students.' } = Astro.props;
const section = sectionFor(Astro.url.pathname);
const photo = photoFor(Astro.url.pathname);
// Sign-in pages sit beside a photo (layout only, so the sign-in pages themselves stay as on build).
const authPhoto = /^\/login\//.test(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '')) ? PHOTOS.picnicTable : undefined;
const fullTitle = title === 'Home' ? 'Hippocratic Council (demo)' : `${title} | Hippocratic Council (demo)`;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href={href('/hippo-icon.png')} />
    <title>{fullTitle}</title>
  </head>
  <body data-section={section}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <DemoBanner />
    <Header />
    {section && (
      <nav class="thumb-index" aria-label="Sections">
        {SECTIONS.map((s) => (
          <a class={`thumb thumb-${s.id}`} href={href(s.home)} aria-current={s.id === section ? 'true' : undefined}>{s.label}</a>
        ))}
      </nav>
    )}
    <main id="main" tabindex="-1">
      <slot name="full-bleed" />
      {photo && (
        <div class="wrap">
          <figure class="page-photo">
            <img src={href(photo.file)} srcset={photo.small ? `${href(photo.small)} 800w, ${href(photo.file)} ${photo.width}w` : undefined}
              sizes="(max-width: 1120px) 100vw, 1072px" width={photo.width} height={photo.height} alt=""
              style={photo.position ? `object-position: ${photo.position}` : undefined} decoding="async" fetchpriority="high" />
          </figure>
        </div>
      )}
      <div class:list={['wrap', { 'auth-split': authPhoto }]}>
        <div class="page-body">
          <div id="flash" class="flash" role="status" hidden></div>
          <slot />
        </div>
        {authPhoto && (
          <figure class="auth-photo">
            <img src={href(authPhoto.file)} width={authPhoto.width} height={authPhoto.height} alt="" decoding="async" />
          </figure>
        )}
      </div>
    </main>
    <Footer />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
